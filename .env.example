# SignalStorm Environment Configuration Example
# Copy this file to laravel/.env and customize

APP_NAME=SignalStorm
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=signalstorm
DB_USERNAME=signalstorm
DB_PASSWORD=signalstormpassword

# Redis Cache & Queue
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ============================================
# TRADING AUTOMATION CONFIGURATION
# ============================================

# Enable/Disable Automation
AUTO_FETCH_DATA=true
AUTO_TRAIN_MODEL=true

# Trading Pairs
TRADING_BTCUSDT_ENABLED=true
TRADING_ETHUSDT_ENABLED=true
TRADING_BNBUSDT_ENABLED=true

# Data Fetching Configuration
FETCH_LIMIT=100
FETCH_SCHEDULE=hourly  # Options: hourly, every30minutes, every15minutes

# Model Training Configuration
TRAINING_DATA_LIMIT=1000
TRAINING_EPOCHS=50
TRAINING_BATCH_SIZE=32
TRAINING_SCHEDULE=daily  # Options: daily, weekly, twiceDaily
TRAINING_SCHEDULE_TIME=02:00

# Advanced Automation
TRAIN_AFTER_FETCH=false
MIN_CANDLES_FOR_TRAINING=500

# ============================================
# DATA PROVIDER CONFIGURATION
# ============================================

# Provider: mock, binance
DATA_PROVIDER=binance

# Binance API (if using binance provider)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_BASE_URL=https://api.binance.com

# ============================================
# NOTIFICATION CONFIGURATION
# ============================================

# Notifiers: console, telegram (comma-separated)
NOTIFIERS=console,telegram

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================
# ML TRAINER SERVICE
# ============================================

# Python Trainer Service URL
TRAINER_SERVICE_URL=http://python-trainer:8001
TRAINER_TIMEOUT=300

# Model Storage: disk, minio
MODEL_STORAGE=disk
MODEL_STORAGE_PATH=storage/models

# MinIO Configuration (if using minio storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=models
MINIO_USE_SSL=false

# ============================================
# LOGGING
# ============================================

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

