# Laravel Application
APP_NAME=SignalStorm
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=signalstorm
DB_USERNAME=signalstorm
DB_PASSWORD=secret

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue
QUEUE_CONNECTION=redis

# Data Provider Strategy (binance, mock)
DATA_PROVIDER=mock

# Binance API Configuration
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

# Notifier Strategy (telegram, console, slack - comma-separated)
NOTIFIERS=console

# Telegram Notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Notifier (optional)
SLACK_WEBHOOK_URL=

# Python Trainer Service
TRAINER_SERVICE_URL=http://python-trainer:8001

# Model Storage (disk, minio)
MODEL_STORAGE=disk

# MinIO Configuration (if using minio storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=models
MINIO_USE_SSL=false

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

